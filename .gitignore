# Cadangan tingkat-root — masing-masing app (app-a-publik/, app-b-admin/)
# sudah punya .gitignore sendiri yang mengecualikan node_modules/.next/.env
# di dalam foldernya; ini cuma jaring pengaman kalau ada yang ke-generate
# tepat di root.
node_modules/
.next/
out/
build/

# env — RAHASIA, jangan pernah commit
.env
.env*.local

.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# file kunci service account kalau tidak sengaja ketaruh di root
*firebase-adminsdk*.json

rules_version = '2';

// Ruang Aman BK — Storage Security Rules
// Sama seperti Firestore: upload logo sekolah (App B) & lampiran chat (kalau
// ada nanti) dilakukan lewat Server Action + Admin SDK, bukan dari client.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
